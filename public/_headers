# Cloudflare Pages: never cache the service worker or the page shell, so a
# new build is always discovered. (Pages reads this file from the build output
# root, dist/, where Vite copies it from public/.)
/sw.js
  Cache-Control: no-cache
/workbox-*.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
